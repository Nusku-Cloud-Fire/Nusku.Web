# ---------------------------------------------------------------------------
# Contact form delivery — app/api/contact/route.ts
#
# All three are read at request time on the server. None of them are exposed to
# the browser (no NEXT_PUBLIC_ prefix), so the key is never shipped to visitors.
#
# Copy this file to .env.local for local development. In production they are
# application settings on the Azure Static Web App — NOT GitHub secrets, which
# only exist during the build and leave the route seeing them unset. See
# "Contact form" in README.md.
# ---------------------------------------------------------------------------

# API key from https://resend.com/api-keys (starts with "re_"). Sending
# permission is enough. Without it the form shows its "escríbenos a
# info@nusku.cloud" fallback rather than silently dropping the lead.
RESEND_API_KEY=

# Where the lead notification is delivered. Any inbox — it does not need to be
# on the verified domain.
CONTACT_TO_EMAIL=

# The "From" address. This one MUST be on a domain verified in Resend
# (https://resend.com/domains), otherwise Resend rejects the send.
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Private documentation — app/api/docs/* and /documentacion
#
# Same rules as above: read at runtime on the server, so in production they are
# application settings on the Azure Static Web App, not GitHub secrets. Login
# links are sent with RESEND_API_KEY from the block above.
# ---------------------------------------------------------------------------

# Signing key for login links and session cookies, at least 32 bytes. Generate
# one with: openssl rand -base64 48
# Without it the documentation shows "acceso no disponible" and nobody gets in.
# Rotating it signs everyone out.
DOCS_AUTH_SECRET=

# The "From" address of the login emails. Must be on a domain verified in
# Resend. Defaults to docs@nusku.cloud.
DOCS_FROM_EMAIL=

# Optional. Base URL used to build the login link (no trailing slash). When
# empty it is derived from the request headers.
SITE_URL=
