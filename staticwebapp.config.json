{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "never",
  "routes": [
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/api/contact",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "anonymous"
      ]
    }
  ],
  "mimeTypes": {
    ".avif": "image/avif"
  }
}
